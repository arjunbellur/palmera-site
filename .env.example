# Server-side environment for the dashboard (Vercel → Project → Environment
# Variables; locally in .env.local, which is git-ignored). Values are never
# committed. Staging gets its own set of all four.

# Resend API key for the verified palmeraexp.com sender (every transactional
# mail: partner + member booking mails, invites, agreements, payouts).
RESEND_API_KEY=

# Bearer secret the scheduled backstop uses (GitHub Actions secret of the
# same name + Vercel cron) to call POST /api/notify/bookings.
CRON_SECRET=

# Bearer secret the app's Cloud Functions use to call POST /api/notify/event
# (docs/app-notify-event-contract.md). Distinct from CRON_SECRET so either
# can be rotated alone; the staging functions get the staging value.
NOTIFY_SECRET=

# Firebase service-account JSON, base64-encoded (one unbreakable token).
# Alternatives read by src/lib/firebase-admin.ts: FIREBASE_SERVICE_ACCOUNT
# (raw JSON) or GOOGLE_APPLICATION_CREDENTIALS (file path, local dev).
FIREBASE_SERVICE_ACCOUNT_B64=

# Public Firebase web config (safe to expose; already set in Vercel).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

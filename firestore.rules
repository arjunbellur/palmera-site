rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Palmera — Firestore security rules (MERGED: partner dashboard + customer app)
//
// Base: Jordan's v3.3 release (Jul 28) — providers/companies/experiences/
// bookings/ledger/payouts/config/countersignatures + customer-app section.
// Merged in (Samson, 2026-08-06):
//   • support_messages — "Talk to a human" now really delivers to the team
//   • reviews: update/delete OWN review (Jordan P12 p2-2)
//   • friends: either side of the edge may update/delete (unfriend removes
//     both directions)
//   • Tightened the ⚠ spots flagged in the Jul 28 release where both clients
//     stay unaffected: favorites delete-own, notifications create-own,
//     points_ledger read-own + append-only.
// Cloud Functions use the Admin SDK and bypass all of this.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in ['palmeraexp@gmail.com'];
    }
    function signedIn() { return request.auth != null; }
    // Does an existing company doc belong to the caller?
    function ownsCompany(companyId) {
      return signedIn() &&
        get(/databases/$(database)/documents/companies/$(companyId)).data.providerId == request.auth.uid;
    }
    // On an update, is `field` unchanged between the stored doc and the write?
    // Uses .get(field, null) so a missing field compares equal to a missing field.
    function keep(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // ── Config: reference data (markets, categories, policies, countersignatory).
    // Reference data is PUBLIC so the customer app can render city/category
    // filters before a guest logs in. countersignatory (Palmera's signing
    // representative) stays signed-in only — it isn't customer-facing.
    match /config/{doc} {
      allow read: if doc != 'countersignatory' || signedIn();
      allow write: if isAdmin();
    }
    // ── Countersignatures — admin writes; owner reads their own executed block.
    match /countersignatures/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    // ── Migration archive — raw legacy data + KYC. NO client access at all
    // (only the Admin SDK, which bypasses rules, ever touches it).
    match /migrationArchive/{uid} {
      allow read, write: if false;
    }

    // ══ Schema v3.2 ══════════════════════════════════════════════════════════
    // Providers (the person). Owner reads/writes own doc; admin reads all.
    match /providers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
      // Admin-only subdoc (status). Owner may read; only admin writes.
      match /private/{doc} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow write: if isAdmin();
      }
    }
    // Companies (a business). Owner = the referenced provider.
    match /companies/{companyId} {
      allow read: if signedIn() && (resource.data.providerId == request.auth.uid || isAdmin());
      // A provider creates their own company, but can NOT self-activate it.
      allow create: if signedIn()
                    && request.resource.data.providerId == request.auth.uid
                    && request.resource.data.get('active', false) == false;
      // Admin may change anything. Owner may edit profile fields but may NOT
      // change ownership or flip `active` (commission activation).
      allow update: if isAdmin();
      allow update: if signedIn()
                    && resource.data.providerId == request.auth.uid
                    && keep('providerId')
                    && keep('active');
      allow delete: if isAdmin();
      // The partner's own payout details — owner read/write, admin read.
      match /private/payout {
        allow read, write: if isAdmin() || ownsCompany(companyId);
      }
      match /private/{doc} {
        // Owner reads own rate; only admin writes commission/activation.
        allow read: if signedIn() &&
          (get(/databases/$(database)/documents/companies/$(companyId)).data.providerId == request.auth.uid || isAdmin());
        allow write: if isAdmin();
      }
    }
    // Experiences (shared listing). PUBLISHED listings are public — the customer
    // app lets guests browse before signing in. Everything unpublished stays
    // visible only to its owner and admins.
    match /experiences/{id} {
      allow read: if resource.data.status == 'published'
                  || resource.data.get('active', false) == true
                  || (signedIn() && (resource.data.providerId == request.auth.uid || isAdmin()));
      // Create for yourself under a company you own — or as admin on a
      // partner's behalf (providerId = the partner, never the admin). `active`
      // must stay consistent with `status`; curation `tag` is Palmera's alone
      // (admins may set it at creation, partners may not).
      allow create: if signedIn()
                    && ((request.resource.data.providerId == request.auth.uid
                         && ownsCompany(request.resource.data.companyId)
                         && request.resource.data.get('tag', null) == null
                         && request.resource.data.get('rating', 0) == 0
                         && request.resource.data.get('reviews', 0) == 0)
                        || isAdmin())
                    && request.resource.data.get('active', false) == (request.resource.data.get('status', 'draft') == 'published');
      // Admin may change anything (publish, tag, curate).
      allow update: if signedIn() && isAdmin();
      // Owner may edit AND publish/unpublish their own listing:
      //   • `active` must always equal (status == 'published')
      //   • `tag` stays admin-only; ownership immutable; rating server-owned
      allow update: if signedIn()
                    && resource.data.providerId == request.auth.uid
                    && keep('providerId')
                    && keep('companyId')
                    && keep('tag')
                    && keep('rating')
                    && keep('reviews')
                    && request.resource.data.get('active', false) == (request.resource.data.get('status', 'draft') == 'published');
      allow delete: if isAdmin() || (signedIn() && resource.data.providerId == request.auth.uid);
      // Options subcollection — public read, same as the listing they belong to.
      match /options/{optionId} {
        // Visible exactly when the parent listing is: published → public;
        // otherwise owner/admin only (draft pricing must not leak by id).
        allow read: if get(/databases/$(database)/documents/experiences/$(id)).data.status == 'published'
                    || get(/databases/$(database)/documents/experiences/$(id)).data.get('active', false) == true
                    || (signedIn() && (get(/databases/$(database)/documents/experiences/$(id)).data.providerId == request.auth.uid || isAdmin()));
        allow write: if signedIn() &&
          (get(/databases/$(database)/documents/experiences/$(id)).data.providerId == request.auth.uid || isAdmin());
      }
    }

    // ══ v3.3 — reservations & money ═══════════════════════════════════════════
    // bookings — provider reads their own; admin all; customer reads + creates
    // + updates their OWN with anchors and money frozen; partner answers
    // pending (confirm/decline) and marks confirmed no-show after the fact.
    match /bookings/{id} {
      allow read: if signedIn() && (resource.data.providerId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
      // Customer app: a member reads + creates their OWN bookings.
      allow read: if signedIn() && resource.data.customerId == request.auth.uid;
      // Create was previously constrained ONLY by customerId, so a member could
      // fabricate a booking naming any partner as providerId — it would land on
      // that partner's dashboard as a real reservation, push them a "new
      // reservation request", and hold a slot.
      //
      // The anchors must now genuinely belong to the experience being booked.
      // Deliberately NOT constraining status or the money fields: the client
      // legitimately writes status 'confirmed' for instant listings and a real
      // bookingTotal for paid ones (see createBooking), and the commission is
      // recomputed server-side by promoteBookingIfPaid regardless.
      //
      // …and `payment` is SERVER-OWNED. The note above claimed the money fields
      // were safe because promoteBookingIfPaid recomputes them — it does not: it
      // early-returns as soon as the doc already carries a providerId, which the
      // client always writes. So a member could create a booking carrying its own
      // `payment: {status: "completed"}` and a self-chosen bookingTotal, flip it
      // to confirmed, and mint redeemable points from money that never moved.
      // The client never writes this map legitimately (see createBooking), so
      // refusing it costs nothing. Points are additionally gated server-side on
      // payment.status == 'completed' in onBookingWritten.
      allow create: if signedIn()
                    && request.resource.data.customerId == request.auth.uid
                    && !('payment' in request.resource.data)
                    && !('pointsAwarded' in request.resource.data)
                    && request.resource.data.status in ['pending', 'confirmed']
                    && request.resource.data.providerId ==
                       get(/databases/$(database)/documents/experiences/$(request.resource.data.experienceId)).data.providerId;
      // …and may UPDATE their own booking (payment state, cancelling).
      // Anchors and money stay frozen.
      allow update: if signedIn()
                    && resource.data.customerId == request.auth.uid
                    && keep('customerId') && keep('providerId') && keep('companyId') && keep('experienceId')
                    && keep('bookingTotal') && keep('commissionRate')
                    && keep('commissionAmount') && keep('payoutAmount');
      // Partner answers a request for THEIR OWN booking — one-way out of
      // 'pending'; every money field frozen.
      allow update: if signedIn()
                    && resource.data.providerId == request.auth.uid
                    && resource.data.status == 'pending'
                    && request.resource.data.status in ['confirmed', 'declined']
                    && keep('providerId') && keep('companyId') && keep('experienceId')
                    && keep('bookingTotal') && keep('commissionRate')
                    && keep('commissionAmount') && keep('payoutAmount')
                    && keep('currency') && keep('scheduledFor') && keep('guestCount')
                    && keep('payment');
      // …and may mark a CONFIRMED booking no-show, only after its time passed.
      allow update: if signedIn()
                    && resource.data.providerId == request.auth.uid
                    && resource.data.status == 'confirmed'
                    && request.resource.data.status == 'no_show'
                    && request.time > resource.data.scheduledFor
                    && keep('providerId') && keep('companyId') && keep('experienceId')
                    && keep('bookingTotal') && keep('commissionRate')
                    && keep('commissionAmount') && keep('payoutAmount')
                    && keep('currency') && keep('scheduledFor') && keep('guestCount')
                    && keep('payment');
    }
    // ledger — derived money events. Owner reads own; only admin/server writes.
    match /ledger/{id} {
      allow read: if signedIn() && (resource.data.providerId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    // payouts — biweekly batches. Owner reads own; only admin/server writes.
    match /payouts/{id} {
      allow read: if signedIn() && (resource.data.providerId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ══ CUSTOMER-APP USER DATA ════════════════════════════════════════════════
    // profiles/{uid} — PUBLIC directory record: name, handle, avatar, city.
    // Phone / birthday / apns_token used to live here and were readable by every
    // signed-in account (and the app pages 500 at a time), so the whole
    // membership's phone numbers were harvestable in one query. They now live in
    // the owner-only `private` subcollection below. Run /migrateProfilePrivacy
    // ONCE before deploying this, or the old values just sit there exposed.
    // ── TRANSITION WINDOW ───────────────────────────────────────────────────
    // These rules require the NEW client shape (chats carrying `memberIds`,
    // phone/birthday written to the private subdocument). While testers are
    // still on the previous build, the strict form would reject their writes —
    // new chats would fail to create and saving a phone number would error.
    //
    // So the two clauses that depend on the new client are written to accept
    // BOTH shapes for now, and are marked TIGHTEN-AFTER-BUILD. The money holes
    // (points, lifetime_points, is_plus) and every read scope are enforced
    // immediately — those are the parts that actually matter, and no client
    // legitimately writes them.
    //
    // Once the new build is on every device, delete the two marked clauses.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
                    && !('is_plus' in request.resource.data.keys());
      // is_plus is a PAID entitlement, and points / annual_points are redeemable
      // value — a client that can set either grants itself something for free.
      // All three are server-owned (Admin SDK bypasses rules). The private
      // fields are frozen here too so they can never leak back onto the public
      // document.
      // lifetime_points is the PUBLIC score other members compare against, so
      // it's server-owned like the balance. completed_experiences is deliberately
      // writable by its owner: only the client can tell that an elapsed booking
      // was actually attended, and it's a vanity count with nothing to spend.
      // ENFORCED NOW — nothing a client legitimately writes touches these, and
      // they're the fields with real value attached.
      // TIGHTEN-AFTER-BUILD: add `&& keep('phone') && keep('birthday') &&
      // keep('apns_token')` once every device is on the new build. Until then
      // the old client still writes those publicly, and rejecting it would stop
      // people saving a phone number or registering for push at all.
      allow update: if signedIn() && request.auth.uid == uid
                    && keep('is_plus') && keep('points') && keep('annual_points')
                    && keep('lifetime_points');
      allow delete: if signedIn() && request.auth.uid == uid;

      // Phone, birthday, push token, hashed phone. Only the owner reads or
      // writes this; contacts matching runs server-side via /matchContacts.
      match /private/{docId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
    // favorites/{uid}_{expId} — TIGHTENED (was: any user could delete any favorite).
    // Read is now own-scope too: the app only ever queries its own favorites,
    // and a world-readable list lets anyone enumerate what a member has saved.
    match /favorites/{fid} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }
    // moments — create your own; any signed-in user reads the feed.
    match /moments/{mid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }
    // moment_likes/{momentId}_{uid} — like any moment once; unlike only your own.
    match /moment_likes/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }
    // moment_comments/{autoId} — signed-in members comment; delete only your own.
    match /moment_comments/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }
    // friends/{me}_{friend} — either side may update/delete: unfriending
    // removes BOTH directions of the edge (app deletes "<them>_<me>" too).
    match /friends/{edge} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if signedIn() &&
        (resource.data.user_id == request.auth.uid || resource.data.friend_id == request.auth.uid);
    }
    // invites — experience invitations + join requests. Inviter creates;
    // both sides read; either updates status (accept/decline/revoke; the host
    // also stamps the resolved bookingId onto an accepted join_request).
    match /invites/{id} {
      allow read: if signedIn() && (resource.data.inviteeId == request.auth.uid || resource.data.inviterId == request.auth.uid);
      // inviteeId was unconstrained, so anyone could push an "invite" — and
      // therefore a push notification with arbitrary text, including a fake
      // "your share is 999,999 XOF" — to any uid on the platform. You may now
      // only invite someone you actually have a friend edge with.
      allow create: if signedIn()
                    && request.resource.data.inviterId == request.auth.uid
                    && (request.resource.data.inviteeId == request.auth.uid
                        || exists(/databases/$(database)/documents/friends/$(request.auth.uid + '_' + request.resource.data.inviteeId))
                        || exists(/databases/$(database)/documents/friends/$(request.resource.data.inviteeId + '_' + request.auth.uid)));
      allow update: if signedIn() && (resource.data.inviteeId == request.auth.uid || resource.data.inviterId == request.auth.uid);
      allow delete: if signedIn() && resource.data.inviterId == request.auth.uid;
    }
    // notifications — TIGHTENED (was: anyone could notify anyone). The
    // fan-out comes from Cloud Functions (Admin SDK, bypasses rules).
    match /notifications/{nid} {
      allow read, update: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }
    // reviews — public read; create your own; UPDATE/DELETE your own
    // (Jordan P12 p2-2: the author can take their review down).
    match /reviews/{rid} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }
    // points_ledger — TIGHTENED: read your own (+admin); append-only, and
    // only rows stamped with your own uid.
    // points_ledger — read your own; SERVER-WRITTEN ONLY. A client-created row
    // paired with a client-incremented balance was free money: points are
    // redeemable, so anyone could mint and spend them. awardBookingPoints
    // (Cloud Functions, Admin SDK) writes the row and the balance together.
    match /points_ledger/{pid} {
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }
    // support_messages — "Talk to a human." Member creates their own; reads
    // their own thread; the team reads everything in the console / Admin SDK.
    match /support_messages/{sid} {
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false;
    }
    // ══ CHAT — membership-scoped ══════════════════════════════════════════════
    // Previously every signed-in user could read every thread and EVERY MESSAGE
    // on the platform, and could insert themselves into any thread's membership
    // (which also subscribed them to its push notifications). Rules can't join
    // across collections, so membership is denormalized onto the thread as
    // `memberIds`; run /migrateChatMemberIds ONCE before deploying this, or
    // existing conversations go dark.
    function threadMembers(tid) {
      return get(/databases/$(database)/documents/chat_threads/$(tid)).data.memberIds;
    }
    match /chat_threads/{tid} {
      // Every EXISTING thread was backfilled by /migrateChatMemberIds, so this
      // is enforced from the moment it deploys — the leak is closed today.
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      // You must include yourself in a thread you create — otherwise you could
      // fabricate conversations between other people.
      // TIGHTEN-AFTER-BUILD: drop the `!('memberIds' in …)` branch once every
      // device is on the new build. The old client doesn't write memberIds, and
      // without this branch it simply cannot start a conversation. A thread it
      // creates is unreadable until its author updates — which is the safe
      // failure, not a leak.
      allow create: if signedIn()
                    && (request.auth.uid in request.resource.data.memberIds
                        || !('memberIds' in request.resource.data));
      // Members may rename a thread or add people, but never remove themselves
      // or others silently: the list may only grow.
      allow update: if signedIn()
                    && request.auth.uid in resource.data.memberIds
                    && resource.data.memberIds.hasOnly(request.resource.data.memberIds);
    }
    match /chat_members/{cmid} {
      // Own membership rows only — this used to let anyone add themselves to any
      // thread and start receiving its pushes.
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      //
      // The first clause here USED to be `user_id == request.auth.uid` with no
      // reference to the thread at all — so anyone could insert themselves into
      // any thread's membership. Only the READ path was ever closed; the push
      // fan-out (onChatMessageCreated → otherThreadMembers) still reads this
      // collection, so a self-inserted row delivered the sender's name and the
      // first 120 characters of every message to the intruder as a notification
      // they were fully authorised to read. DM thread ids are derivable
      // (`dm_` + the two uids sorted) and profiles are readable by every signed-in
      // member, so the whole uid space was enumerable. Membership may now only be
      // created by someone who is ALREADY in the thread.
      allow create: if signedIn()
                    && request.auth.uid in threadMembers(request.resource.data.thread_id);
      allow update, delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }
    match /chat_messages/{mid} {
      // Resolved through the parent thread rather than copied onto every
      // message. A thread's message query hits the same thread path for every
      // document, so Firestore caches that get() for the whole request.
      allow read: if signedIn() && request.auth.uid in threadMembers(resource.data.thread_id);
      allow create: if signedIn()
                    && request.resource.data.user_id == request.auth.uid
                    && request.auth.uid in threadMembers(request.resource.data.thread_id);
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    // ── Legacy partners/listings — kept live during the v3.2 migration.
    match /partners/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
      match /listings/{listingId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow write: if signedIn() && request.auth.uid == uid;
        allow delete: if isAdmin();
      }
    }
    // Legacy top-level listings fallback the iOS catalog loader still probes.
    match /listings/{doc} {
      allow read: if true;
      allow write: if false;
    }
    // legal — published legal documents (privacy, terms, refund, AI).
    match /legal/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ══ Marketplace (dashboard-owned; the iOS app never touches these) ══════
    // Suppliers = wholesale businesses selling goods to partners (docs:
    // marketplace-plan.md). Concierge onboarding: admin creates the doc with
    // `email` and uid=null; the supplier claims it at first /supplier sign-in
    // by setting uid to their own auth uid and NOTHING else.
    match /suppliers/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid
                    || (resource.data.email == request.auth.token.email && request.auth.token.email_verified == true)
                    || isAdmin());
      // Partners browsing the store see active suppliers.
      allow read: if signedIn() && resource.data.status == 'active';
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
      // The claim: uid null → own uid, all other fields untouched.
      allow update: if signedIn()
                    && request.auth.token.email_verified == true
                    && resource.data.uid == null
                    && resource.data.email == request.auth.token.email
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'updatedAt']);
      // A claimed owner edits their profile but never their own commission,
      // status, claim email, or uid.
      allow update: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && keep('uid') && keep('email') && keep('commissionRate') && keep('status');
      // Payout details / admin notes.
      match /private/{doc} {
        allow read, write: if isAdmin()
          || get(/databases/$(database)/documents/suppliers/$(id)).data.uid == request.auth.uid;
      }
    }
    // Does a supplier doc claimed by the caller back this supplierId?
    function ownsSupplier(supplierId) {
      return signedIn() &&
        get(/databases/$(database)/documents/suppliers/$(supplierId)).data.uid == request.auth.uid;
    }
    // Products — FLAT catalog so the partner store is one query. Any signed-in
    // user browses; only the owning supplier or admin writes.
    match /products/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || ownsSupplier(request.resource.data.supplierId);
      allow update, delete: if isAdmin() || ownsSupplier(resource.data.supplierId);
    }
    // supply_orders — RECEIPTS: money split frozen at submission. Buyer creates
    // 'awaiting_payment' anchored on themselves and reads their own; supplier
    // updates status on their own orders with anchors + money frozen; the
    // Stripe webhook marks paid via the Admin SDK (bypasses rules).
    match /supply_orders/{id} {
      allow read: if signedIn() && (resource.data.partnerId == request.auth.uid || isAdmin());
      allow read: if ownsSupplier(resource.data.supplierId);
      allow create: if signedIn()
                    && request.resource.data.partnerId == request.auth.uid
                    && request.resource.data.status == 'awaiting_payment';
      allow update: if isAdmin();
      allow update: if ownsSupplier(resource.data.supplierId)
                    && keep('partnerId') && keep('companyId') && keep('supplierId')
                    && keep('items') && keep('orderTotal') && keep('commissionRate')
                    && keep('commissionAmount') && keep('supplierNet') && keep('payment');
      // Buyer may close out their own UNPAID checkout — cancelled only.
      allow update: if signedIn()
                    && resource.data.partnerId == request.auth.uid
                    && resource.data.status == 'awaiting_payment'
                    && request.resource.data.status == 'cancelled'
                    && keep('partnerId') && keep('companyId') && keep('supplierId')
                    && keep('items') && keep('orderTotal') && keep('commissionRate')
                    && keep('commissionAmount') && keep('supplierNet') && keep('payment');
    }
    // supplier_ledger — server-written only (Admin SDK); supplier reads own.
    match /supplier_ledger/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.supplierUid == request.auth.uid);
      allow write: if false;
    }
  }
}

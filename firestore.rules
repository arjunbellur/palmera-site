rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['palmeraexp@gmail.com'];
    }
    function signedIn() { return request.auth != null; }
    // Does an existing company doc belong to the caller?
    function ownsCompany(companyId) {
      return signedIn() &&
        get(/databases/$(database)/documents/companies/$(companyId)).data.providerId == request.auth.uid;
    }
    // On an update, is `field` unchanged between the stored doc and the write?
    // Uses .get(field, null) so a missing field compares equal to a missing field.
    function keep(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // ── Config: reference data (markets, categories, policies, countersignatory).
    //    Reference data is PUBLIC so the customer app can render city/category
    //    filters before a guest logs in. countersignatory (Palmera's signing
    //    representative) stays signed-in only — it isn't customer-facing.
    match /config/{doc} {
      allow read: if doc != 'countersignatory' || signedIn();
      allow write: if isAdmin();
    }

    // ── Countersignatures — admin writes; owner reads their own executed block.
    match /countersignatures/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // ── Migration archive — raw legacy data + KYC. NO client access at all
    //    (only the Admin SDK, which bypasses rules, ever touches it).
    match /migrationArchive/{uid} {
      allow read, write: if false;
    }

    // ══ Schema v3.2 ══════════════════════════════════════════════════════════
    // Providers (the person). Owner reads/writes own doc; admin reads all.
    match /providers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
      // Admin-only subdoc (status). Owner may read; only admin writes.
      match /private/{doc} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow write: if isAdmin();
      }
    }

    // Companies (a business). Owner = the referenced provider.
    match /companies/{companyId} {
      allow read: if signedIn() && (resource.data.providerId == request.auth.uid || isAdmin());
      // A provider creates their own company, but can NOT self-activate it.
      allow create: if signedIn()
        && request.resource.data.providerId == request.auth.uid
        && request.resource.data.get('active', false) == false;
      // Admin may change anything. Owner may edit profile fields but may NOT
      // change ownership or flip `active` (commission activation) — that lives
      // in the admin-only private/admin subdoc + this `active` flag.
      allow update: if isAdmin();
      allow update: if signedIn()
        && resource.data.providerId == request.auth.uid
        && keep('providerId')
        && keep('active');
      allow delete: if isAdmin();
      // The partner's own payout details (mobile money / bank reference) —
      // owner-entered in Settings. Owner read/write, admin read.
      match /private/payout {
        allow read, write: if isAdmin() || ownsCompany(companyId);
      }
      match /private/{doc} {
        // Owner reads own rate; only admin writes commission/activation.
        allow read: if signedIn() &&
          (get(/databases/$(database)/documents/companies/$(companyId)).data.providerId == request.auth.uid || isAdmin());
        allow write: if isAdmin();
      }
    }

    // Experiences (shared listing). PUBLISHED listings are public — the customer
    // app lets guests browse before signing in. Everything unpublished (drafts,
    // pending review, archived) stays visible only to its owner and admins.
    // To require login for browsing later, add `signedIn() &&` to the first clause.
    match /experiences/{id} {
      allow read: if resource.data.status == 'published'
        || resource.data.get('active', false) == true
        || (signedIn() && (resource.data.providerId == request.auth.uid || isAdmin()));
      // Create only for yourself AND only under a company you own. The partner
      // owns draft-vs-published for their OWN content, so publishing on create
      // is allowed — but `active` must stay consistent with `status`, and the
      // curation `tag` remains Palmera's alone.
      allow create: if signedIn()
        && request.resource.data.providerId == request.auth.uid
        && ownsCompany(request.resource.data.companyId)
        && request.resource.data.get('active', false) == (request.resource.data.get('status', 'draft') == 'published')
        && request.resource.data.get('tag', null) == null;
      // Admin may change anything (publish, tag, curate).
      allow update: if signedIn() && isAdmin();
      // Owner may edit AND publish/unpublish their own listing. Still enforced
      // by the database, not just the UI:
      //   • `active` must always equal (status == 'published') — no listing that
      //     is live-but-not-published, or published-but-invisible
      //   • `tag` (curation badge) stays admin-only
      //   • ownership is immutable and rating/reviews are server-owned
      allow update: if signedIn()
        && resource.data.providerId == request.auth.uid
        && keep('providerId')
        && keep('companyId')
        && keep('tag')
        && keep('rating')
        && keep('reviews')
        && request.resource.data.get('active', false) == (request.resource.data.get('status', 'draft') == 'published');
      // Owner may delete their own listing. Once real bookings reference
      // experiences, revisit: block deletes with future bookings server-side.
      allow delete: if isAdmin() || (signedIn() && resource.data.providerId == request.auth.uid);
      // Options subcollection — public read, same as the listing they belong to.
      // They carry no sensitive data (name, description, price, photos) and are
      // meaningless without their parent experience.
      match /options/{optionId} {
        allow read: if true;
        allow write: if signedIn() &&
          (get(/databases/$(database)/documents/experiences/$(id)).data.providerId == request.auth.uid || isAdmin());
      }
    }

    // ══ v3.3 — reservations & money ═══════════════════════════════════════════
    // The partner NEVER writes any of these from the dashboard — they are the
    // customer app's / server's to write, and read-only for the owning provider.
    //
    // bookings — owner reads their own; admin reads all. Client writes are denied
    // here: bookings are created by the app (Admin SDK / trusted server), which
    // bypasses rules. When the app writes with the client SDK instead, tighten to
    // an authenticated-customer create rule — do NOT open provider writes.
    match /bookings/{id} {
      allow read: if signedIn() && (resource.data.providerId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
      // Customer app (Samson, 2026-07-27): a member reads + creates their OWN
      // bookings from the client SDK. ⚠ Money fields are client-authored under
      // this rule — needs server-side validation before real payments.
      allow read:   if signedIn() && resource.data.customerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      // The partner may answer a request for THEIR OWN booking — confirm or
      // decline a pending one, nothing else. Every money field is frozen, so a
      // partner can never rewrite what they're owed, and the transition is
      // one-way out of 'pending' (no un-declining, no self-completing).
      allow update: if signedIn()
        && resource.data.providerId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['confirmed', 'declined']
        && keep('providerId') && keep('companyId') && keep('experienceId')
        && keep('bookingTotal') && keep('commissionRate')
        && keep('commissionAmount') && keep('payoutAmount')
        && keep('currency') && keep('scheduledFor') && keep('guestCount');
      // …and may mark a CONFIRMED booking no-show, but only after its
      // scheduled time has passed. One-way; money fields stay frozen; a
      // partner can never mark 'completed' (that's what triggers their credit).
      allow update: if signedIn()
        && resource.data.providerId == request.auth.uid
        && resource.data.status == 'confirmed'
        && request.resource.data.status == 'no_show'
        && request.time > resource.data.scheduledFor
        && keep('providerId') && keep('companyId') && keep('experienceId')
        && keep('bookingTotal') && keep('commissionRate')
        && keep('commissionAmount') && keep('payoutAmount')
        && keep('currency') && keep('scheduledFor') && keep('guestCount');
    }

    // ledger — derived money events. Owner reads own; only admin/server writes.
    match /ledger/{id} {
      allow read: if signedIn() && (resource.data.providerId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // payouts — biweekly batches. Owner reads own; only admin/server writes.
    match /payouts/{id} {
      allow read: if signedIn() && (resource.data.providerId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ══ CUSTOMER-APP USER DATA (Samson, 2026-07-27) ═══════════════════════════
    // Social layer: profiles, friends, moments, chat, points. Kept verbatim from
    // his deploy so repo == live. Review notes are inline (⚠) — behavior changes
    // go through Samson, not silently here.
    match /profiles/{uid} {
      allow read:            if signedIn();
      allow create, update:  if signedIn() && request.auth.uid == uid;
      allow delete:          if signedIn() && request.auth.uid == uid;
    }
    // favorites/{uid}_{expId}
    match /favorites/{fid} {
      allow read:   if signedIn();
      allow write:  if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if signedIn();  // ⚠ any user can delete anyone's favorite
    }
    // moments — create your own; any signed-in user reads the feed.
    match /moments/{mid} {
      allow read:            if signedIn();
      allow create:          if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete:  if signedIn() && resource.data.user_id == request.auth.uid;
    }
    // friends/{me}_{friend}
    match /friends/{edge} {
      allow read:            if signedIn();
      allow create:          if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete:  if signedIn() && resource.data.user_id == request.auth.uid;
    }
    match /notifications/{nid} {
      allow read, update: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create:       if signedIn();  // ⚠ anyone can notify anyone (spam vector)
    }
    // reviews — public read; signed-in users create their own.
    match /reviews/{rid} {
      allow read:   if true;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
    }
    // points_ledger — ⚠ read is ALL users (not "your own"), and users write
    // their own rows → self-granted points. Needs server-side issuance.
    match /points_ledger/{pid} {
      allow read:  if signedIn();
      allow write: if signedIn() && request.resource.data.user_id == request.auth.uid;
    }
    // chat — ⚠ no membership check: every signed-in user can read all threads
    // and messages. Fine for closed testing; must scope before launch.
    match /chat_threads/{tid}  { allow read, create, update: if signedIn(); }
    match /chat_members/{cmid} { allow read, create: if signedIn(); }
    match /chat_messages/{mid} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
    }

    // ── Legacy partners/listings — kept live during the v3.2 migration; removed
    //    at cutover once every consumer page is on the new collections.
    match /partners/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
      match /listings/{listingId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow write: if signedIn() && request.auth.uid == uid;
        allow delete: if isAdmin();
      }
    }
  }
}
